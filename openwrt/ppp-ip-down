#!/bin/sh
# /etc/ppp/ip-down —— srun 断开时调用
#
# 这里【不清空】/tmp/resolv.conf.d/resolv.conf.auto。
# 原因：重启/重拨时，旧会话的 ip-down 有可能在新会话的 ip-up 之后才执行，
# 清空会把刚写好的上游 DNS 又擦掉，dnsmasq 就返回 REFUSED —— 客户端表现
# 就是"连上了但找不到 DNS 地址 / 无法访问互联网"。保留上一次的上游地址无害，
# 重连后 ip-up 会覆盖它。

logger -t srun-ipup "down $1（保留上游 DNS，不清空）"

# IPv6 是随会话走的：停掉 odhcp6c，撤掉全局地址和默认路由（fe80 留给 pppd）
if [ -f /var/run/srun6.pid ]; then
	kill "$(cat /var/run/srun6.pid)" 2>/dev/null
	rm -f /var/run/srun6.pid
fi
for a in $(ip -6 addr show dev "$1" | awk '/inet6 (2|3)/{print $2}'); do
	ip -6 addr del "$a" dev "$1" 2>/dev/null
done
ip -6 route del default dev "$1" 2>/dev/null
logger -t srun-ipv6 "v6 cleaned on $1"

exit 0
