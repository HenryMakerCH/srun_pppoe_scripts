#!/bin/sh /etc/rc.common
# /etc/init.d/srun —— Srun PPPoE 拨号（procd 托管）
# 主循环和重拨在 /usr/bin/srun.sh dial 里；procd 只负责拉起 + 兜底重启。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/srun.sh
IFACE=wan
ENTRY=srun
HOLDOFF=30

start_service() {
	[ -s /etc/srun/passwd ] || {
		logger -t srun "缺少 /etc/srun/passwd 或内容为空，未启动"
		return 1
	}
	[ -s /etc/srun/account ] || {
		logger -t srun "缺少 /etc/srun/account，未启动"
		return 1
	}
	# 上一轮如果被强杀，pppd 会变成孤儿继续占着 PPPoE 会话，
	# 新实例再拨就会一直 rc=8（发现不到 PADO）。启动前先清场。
	"$PROG" down >/dev/null 2>&1
	procd_open_instance
	procd_set_param command "$PROG" dial -i "$IFACE" -n "$ENTRY" --holdoff "$HOLDOFF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 注意：OpenWrt 的 reboot 不会调用 init 脚本的 stop（procd 直接停服务），
	# 所以这里的 touch 只在手动重启服务时生效；真正兜底的是 cron 每分钟 touch。
	touch /etc/srun/timestamp 2>/dev/null
	"$PROG" down
	# 兜底：argv[1] 恰好是 srun.sh 的主循环 + pppd 的 nic-<if>
	for _p in /proc/[0-9]*; do
		[ -r "$_p/cmdline" ] || continue
		_pid=${_p#/proc/}
		[ "$_pid" = "$$" ] && continue
		_a2=$(tr '\0' '\n' < "$_p/cmdline" 2>/dev/null | sed -n '2p')
		if [ "$_a2" = "$PROG" ]; then
			kill -TERM "$_pid" 2>/dev/null
			continue
		fi
		if tr '\0' ' ' < "$_p/cmdline" 2>/dev/null | grep -q "pppoe\.so nic-$IFACE"; then
			kill -TERM "$_pid" 2>/dev/null
		fi
	done
}
