#!/bin/sh
# /etc/ppp/ip-up —— srun.sh 启动的 pppd 连上后调用
# 参数: $1=接口 $2=tty $3=速度 $4=本端IP $5=对端IP $6=ipparam
# usepeerdns 会把服务器下发的 DNS 放进 $DNS1/$DNS2

[ -d /tmp/resolv.conf.d ] || mkdir -p /tmp/resolv.conf.d
{
	echo "# srun pppoe $(date '+%F %T')"
	[ -n "${DNS1:-}" ] && echo "nameserver $DNS1"
	[ -n "${DNS2:-}" ] && echo "nameserver $DNS2"
} > /tmp/resolv.conf.d/resolv.conf.auto

# 告诉 srun.sh「这次认证成功了」（它靠这个标记判断要不要继续扫时间偏差）
touch /tmp/srun-ok

logger -t srun-ipup "up $1 local=$4 peer=$5 dns=${DNS1:-?},${DNS2:-?}"
/etc/init.d/dnsmasq reload >/dev/null 2>&1

# ---- IPv6：校园网对 DHCPv6 不应答，只在 RA 里给 /64 + 默认路由 ----
# 所以用 odhcp6c 的 RA 通道（脚本 /etc/srun/v6.sh 负责装地址和默认路由）。
# 注意：不能让 netifd 管理这个接口（proto dhcpv6），它会在 setup/teardown 时
# 把 pppd 刚分配的 IPv4/IPv6 地址一起 flush，直接断网。
#  2) 必须用 start-stop-daemon 起，裸 `&` 会被 SSH/父进程退出时的 SIGHUP 收走。
P6=/var/run/srun6.pid
/sbin/start-stop-daemon -K -q -p "$P6" 2>/dev/null
rm -f "$P6"
/sbin/start-stop-daemon -S -q -b -m -p "$P6" -x /usr/sbin/odhcp6c -- -s /etc/srun/v6.sh -f "$1"
sleep 1
logger -t srun-ipv6 "odhcp6c started on $1 pid $(cat $P6 2>/dev/null)"

exit 0
